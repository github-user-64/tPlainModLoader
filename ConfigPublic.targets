<!--复制一份该文件并重命名为"ConfigPublic.targets"-->

<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<!--输出位置选择-->
		<OutPathSwitch>0</OutPathSwitch>

		<GmaeDllPath>F:\F_MY1\File\RJWJ\C#\Projects\tPlainModLoader\dll</GmaeDllPath>
		<DllTerraria>$(GmaeDllPath)\Terraria_v1.4.5.8.exe</DllTerraria>
		<DllReLogic>$(GmaeDllPath)\ReLogic.dll</DllReLogic>
	</PropertyGroup>
	
	<!--输出位置0-->
	<PropertyGroup Condition="'$(OutPathSwitch)'=='0'">
		<tPMLOutPath>F:\F_MY1\File\RJWJ\C#\Projects\tPlainModLoader\tPlainModLoader\tPlainModLoader\bin\Debug</tPMLOutPath>
		<tPMLOutPathMod>$(tPMLOutPath)\Mods</tPMLOutPathMod>
		
		<DeBugStartProgram>$(tPMLOutPath)\tPlainModLoader.exe</DeBugStartProgram>
	</PropertyGroup>
	
	<!--输出位置1-->
	<PropertyGroup Condition="'$(OutPathSwitch)'=='1'">
		<tPMLOutPath>F:\F_MY1\快速存储(记得清理)\tPlainModLoader</tPMLOutPath>
		<tPMLOutPathMod>F:\F_MY1\快速存储(记得清理)\Mods</tPMLOutPathMod>
		
		<DeBugStartProgram></DeBugStartProgram>
	</PropertyGroup>

	<!--引用-->
	<ItemGroup>
		<Reference Include="ReLogic">
			<HintPath>$(DllReLogic)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Terraria">
			<HintPath>$(DllTerraria)</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>